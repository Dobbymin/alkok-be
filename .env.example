# Server
NODE_ENV=development
PORT=8080
APP_BASE_URL=http://localhost:8080
WEB_BASE_URL=http://localhost:3000
CORS_ORIGINS=https://alkok.dobbymin.cloud,http://localhost:3000,http://localhost:3001,http://localhost:18101,http://localhost:18103

# Database (PostgreSQL 17)
DATABASE_URL=postgresql://alkok:alkok@localhost:5432/alkok?schema=public

# Auth & Security
JWT_ACCESS_SECRET=replace-with-32-plus-char-random-secret-in-prod
IP_HASH_SALT=replace-with-random-salt-in-prod

# Mail (local: mailpit, prod: resend)
MAIL_PROVIDER=mailpit
MAIL_FROM=noreply@alkok.dobbymin.cloud
SMTP_HOST=localhost
SMTP_PORT=1025
RESEND_API_KEY=

# AI Pipeline (primary: hermes, fallback: gemini)
AI_PRIMARY_PROVIDER=hermes
HERMES_BASE_URL=http://172.22.0.1:8642
HERMES_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_MONTHLY_BUDGET_USD=15

# Notifications
DISCORD_WEBHOOK_URL=

# Scheduler
ENABLE_SCHEDULER=true

# Seed Admin
SEED_ADMIN_EMAIL=admin@alkok.dobbymin.cloud
SEED_ADMIN_PASSWORD=ChangeMeAdmin123!
